# Copy to .env and adjust.
DATABASE_URL="postgresql://propertynest@localhost:5433/propertynest?schema=public"
SITE_URL="http://localhost:3000"

# Secrets: generate with  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=""
IP_HASH_SALT=""

# Dev only: shows the SMS code on the login screen. Never set this in production.
OTP_DEV_ECHO="1"

# SMS: console | semaphore   (semaphore.co, Philippine SMS gateway)
SMS_PROVIDER="console"
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER="PropNest"

# Email: console | resend
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="PropertyNest <noreply@propertynest.ph>"

# Photo storage folder for the local driver
UPLOAD_DIR="../.uploads"

# Sign in with Google: create an OAuth client (Web application) in Google Cloud Console,
# authorized redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
