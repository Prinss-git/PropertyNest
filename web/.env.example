# PropertyNest settings. Copy to .env for local development; on a host, set these as environment variables.
# On a live site (SITE_URL starts with https://) the app and worker refuse to start if a required setting is
# missing or unsafe, and print what to fix. See DEPLOY.md.

# ── Core ─────────────────────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://propertynest@localhost:5433/propertynest?schema=public"
SITE_URL="http://localhost:3000"            # live: https://propertynest.ph (turns on secure cookies, HSTS, strict checks)

# Secrets. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=""                               # live: required, 32+ characters
IP_HASH_SALT=""                             # live: required, 16+ characters

# Development only: shows SMS login codes on screen. A live site refuses to start with this set.
OTP_DEV_ECHO="1"

# Which header holds the visitor's real IP (for rate limits):
#   x-forwarded-for (default, last address, added by the host's proxy) | cf-connecting-ip (behind Cloudflare) | x-real-ip
CLIENT_IP_HEADER="x-forwarded-for"

# ── SMS (login codes, inquiry alerts) ───────────────────────────────────────────────────────────────
SMS_PROVIDER="console"                      # console (logs only) | semaphore (live: required)
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER="PropNest"                 # sender name registered with Semaphore

# ── Email (confirmations, password resets, alerts) ──────────────────────────────────────────────────
EMAIL_PROVIDER="console"                    # console | resend (live: required)
RESEND_API_KEY=""
EMAIL_FROM="PropertyNest <noreply@propertynest.ph>"   # domain must be verified in Resend
SUPPORT_EMAIL=""                            # receives Contact-page messages, shown on Help/Contact

# ── Photo storage ────────────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER="local"                      # local | s3 (Cloudflare R2 or AWS S3, recommended live)
UPLOAD_DIR="../.uploads"                    # local driver only
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                              # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION=""                                # AWS: e.g. ap-southeast-1 (R2 uses "auto")
S3_FORCE_PATH_STYLE=""                      # "1" for MinIO / self-hosted S3
MEDIA_BASE_URL=""                           # optional: public bucket or CDN URL to serve photos directly

# ── Maps ─────────────────────────────────────────────────────────────────────────────────────────────
# Tile URL and attribution are read when the app is BUILT (NEXT_PUBLIC_*): set them before `npm run build`.
NEXT_PUBLIC_MAP_TILE_URL=""                 # empty = OpenStreetMap (light use only). e.g. Geoapify:
                                            # https://maps.geoapify.com/v1/tile/osm-bright/{z}/{x}/{y}.png?apiKey=KEY
NEXT_PUBLIC_MAP_ATTRIBUTION=""              # attribution HTML your tile provider requires
NEARBY_PROVIDER="nominatim"                 # nominatim (free, light use) | geoapify (live) | none (tests)
GEOAPIFY_API_KEY=""

# ── Sign in with Google (optional) ───────────────────────────────────────────────────────────────────
# Google Cloud Console → OAuth client (Web application); redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Monitoring (optional, recommended for the live site) ──────────────────────────────────────────────
# Error alerts: sentry.io → create a Next.js project → Settings → Client Keys (DSN). Free tier is enough.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""           # "production" (default), or "staging" on a staging copy
SENTRY_AUTH_TOKEN=""                        # optional, at build time: readable stack traces (source maps)
SENTRY_ORG=""                               # with SENTRY_AUTH_TOKEN: your Sentry organisation slug
SENTRY_PROJECT=""                           # with SENTRY_AUTH_TOKEN: the project slug
# Visitor statistics: Cloudflare dashboard → Analytics & Logs → Web Analytics → add site → copy the token.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""

# ── Other ────────────────────────────────────────────────────────────────────────────────────────────
DEV_TOOLS="1"                               # local only: developer panel (switch accounts, read sent SMS/email). Never live.
DEMO_MODE=""                                # "1" on a staging site with sample data (shows a notice in the footer)
ALLOW_SEED=""                               # "1" lets `npm run db:seed` wipe an https site's database (staging only!)
