{
  "name": "propertynest-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/devdb.mjs init",
    "db:start": "node scripts/devdb.mjs start",
    "db:stop": "node scripts/devdb.mjs stop",
    "db:status": "node scripts/devdb.mjs status",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "test:api": "node tests/api.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "test": "node tests/api.test.mjs && node tests/ui.test.mjs",
    "maintenance": "node --env-file-if-exists=.env --import tsx scripts/maintenance.ts",
    "create-admin": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@prisma/client": "^6.9.0",
    "@sentry/nextjs": "10.77.1",
    "@sentry/node": "10.77.1",
    "leaflet": "^1.9.4",
    "next": "15.5.29",
    "prisma": "^6.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/leaflet": "1.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autocannon": "8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
